
profiles {

    apptainer {

        singularity.enabled = false

        apptainer.enabled = true

        apptainer.autoMounts = true

        apptainer.cacheDir = '/N/slate/gkarutur/apptainer_cache'

        process {

            withName: TXIMPORT {
                container = 'docker://ghcr.io/geethcodes/rnaseq-r:1.0.0'
            }

            withName: DESEQ2 {
                container = 'docker://ghcr.io/geethcodes/rnaseq-r:1.0.0'
            }
        }
    }
}

